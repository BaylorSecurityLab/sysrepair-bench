# Runtime vLLM args for hpc/vllm_serve.slurm.
#
#   cp hpc/vllm_args.env.example ~/hpc/vllm_args.env    # then edit SIF/SCRATCH
#
# vllm_serve.slurm sources this at JOB START, not at submit time. That matters
# because Slurm snapshots the batch script when you submit, and the gpuH200x8
# queue can be days deep -- editing this file lets you correct a flag on a
# queued job without resubmitting and losing your place in the queue.
#
# NOTE: this file is a template. The live copy (hpc/vllm_args.env) is
# gitignored, because anything named *.env attracts credentials. Never put an
# API key here: vllm_serve.slurm mints a fresh one per job and writes it to
# ~/.vllm_delta/conn_<jobid>.env with mode 0600.

# ---------------------------------------------------------------- container
# The site llmflux container (vLLM 0.15.0) CANNOT load Qwen3.5: its registry has
# no Qwen3_5MoeForConditionalGeneration. And `vllm/vllm-openai:latest` cannot run
# on Delta at all -- it ships torch+cu130 and every worker dies with "The NVIDIA
# driver on your system is too old (found version 12080)". Delta's driver is CUDA
# 12.8, so use a cu129 build; minor-version compatibility covers 12.9 -> 12.8.
# Build it with: sbatch hpc/pull_container.slurm
SIF="${SCRATCH:?set SCRATCH or edit this path}/containers/vllm-openai-cu129.sif"

# Apptainer inherits the host environment, and Delta sets CUDA_HOME to an
# /opt/nvidia/hpc_sdk path that does not exist inside the container. DeepGEMM
# JIT-compiles the FP8 MoE kernels at runtime and asserts on $CUDA_HOME/bin/nvcc:
#   RuntimeError: Assertion error (...jit/compiler.hpp:175):
#     std::filesystem::exists(nvcc_path)
# The container ships its own toolkit, so point at that. Preferred over
# VLLM_USE_DEEP_GEMM=0, which would give up the fast FP8 grouped-GEMM kernels.
export APPTAINERENV_CUDA_HOME=/usr/local/cuda

# -------------------------------------------------------------------- model
MODEL="Qwen/Qwen3.5-397B-A17B-FP8"
SERVED_NAME="qwen3.5-397b"

# Full native context (text_config.max_position_embeddings). vLLM's "maximum
# concurrency" log line is worst-case (kv_pool / max_model_len, i.e. every
# request filling the whole window); PagedAttention allocates per block, so
# short requests are unaffected. Needed once message_limit is unlimited, since a
# long repair session can accumulate past 32k of tool output.
MAX_LEN=262144
GPU_UTIL=0.92

# --tool-call-parser qwen3_xml, NOT hermes. Verified from the checkpoint's own
# chat_template.jinja, which instructs the model to emit
#   <tool_call><function=name><parameter=p>v</parameter></function></tool_call>
# hermes expects JSON inside <tool_call> and would parse ZERO tool calls -- the
# server starts fine, passes health checks, and every tool-driven sample fails.
#
# --language-model-only drops the vision tower; this benchmark is text-only.
EXTRA_ARGS="--language-model-only --enable-auto-tool-choice --tool-call-parser qwen3_xml --enable-prefix-caching"

# --------------------------------------------------------------- parallelism
# Selected on GPU count so one file can serve several queued jobs; a bare
# assignment would hijack every one of them.
#
#   8 -> -tp 8 (derived by vllm_serve.slurm). Certified upstream.
#   5,6 -> -pp N. Tensor/expert parallel CANNOT do 5 or 6: num_experts=512,
#        num_attention_heads=32, moe_intermediate_size=1024 are powers of two.
#        Pipeline parallel shards by LAYER, and num_hidden_layers=60 divides by
#        both. PP also avoids the OOM that kills 4-GPU expert-parallel, because
#        it does not replicate attention/dense on every rank.
#   7 -> works (vLLM splits 60 as 8,8,9,9,9,9,8) but is DOMINATED by 6: the 7th
#        GPU only drops the slowest stage from 10 layers to 9, so you pay ~17%
#        more for ~11% more speed. See hpc/pp_balance.py.
#   4 -> OOMs. Expert parallel replicates attention/dense per rank: ~134 GiB on
#        a 140 GiB card, leaving no room for KV cache.
case "${SLURM_GPUS_ON_NODE:-}" in
  5) PARALLEL_ARGS="-pp 5" ;;
  6) PARALLEL_ARGS="-pp 6" ;;
  7) PARALLEL_ARGS="-pp 7" ;;
  *) : ;;   # leave unset; vllm_serve.slurm derives it from the GPU count
esac
