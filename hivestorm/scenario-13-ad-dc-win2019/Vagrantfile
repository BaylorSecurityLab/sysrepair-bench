# Hivestorm scenario-13 — Windows Server 2019 AD DC (single-domain).
#
# DCPROMO architecture (single-shot, no WinRM session held during SAM destruction):
#   Install-ADDSForest destroys the local SAM the moment it returns. ANY
#   concurrent WinRM-driven provisioner gets 401'd mid-execution. So we
#   collapse all post-promotion work (DA grant + seed + OpenSSH + scrub +
#   marker) into a single SYSTEM-context AtStartup task that runs OUTSIDE
#   any WinRM session.
#
#   Flow:
#     1. 01-register-dc-bootstrap.ps1 (WinRM, local SAM alive):
#          - stage roles.json, dc-bootstrap.ps1, seed.ps1, vagrant_key.pub
#            into C:\hs13-setup\
#          - Install-WindowsFeature AD-Domain-Services
#          - Register-ScheduledTask hs13-bootstrap (SYSTEM, AtStartup,
#            payload = C:\hs13-setup\bootstrap.ps1)
#     2. config.vm.provision :reload — graceful reboot via vagrant-reload.
#     3. hs13-bootstrap fires (SYSTEM, no WinRM):
#          Install-ADDSForest -NoReboot
#          → wait for AD Web Services
#          → Add-ADGroupMember Domain Admins (OPS\vagrant)  ← unblocks WinRM
#          → run seed.ps1
#          → install OpenSSH + bridge pubkey + sshd_config fix
#          → scrub answer key
#          → write BOOTSTRAP_COMPLETE marker, unregister task
#     4. 02-wait-bootstrap.ps1 (WinRM as OPS\vagrant — works because
#        Phase B granted DA before writing the marker): polls for the
#        marker and exits.
#
# Requires the vagrant-reload plugin: `vagrant plugin install vagrant-reload`.

require 'json'

ROLES_PATH = File.join(File.dirname(__FILE__), 'build', 'roles.json')
unless File.exist?(ROLES_PATH)
  abort "missing #{ROLES_PATH}. Run `hivestorm/prepare.sh 13` first."
end

BRIDGE_PUBKEY_PATH = File.join(File.dirname(__FILE__), 'build', 'vagrant_key.pub')
unless File.exist?(BRIDGE_PUBKEY_PATH)
  abort "missing #{BRIDGE_PUBKEY_PATH}. Run via Inspect AI (it generates the bridge keypair) or generate manually with `ssh-keygen -t ed25519 -N '' -f build/vagrant_key`."
end

Vagrant.configure("2") do |config|
  # jborean93/WindowsServer2019 is the proven-working box used by meta4/ad-vm.
  # gusztavvargadr's box failed to bring up WinRM reliably on this host.
  config.vm.box = "jborean93/WindowsServer2019"
  config.vm.hostname = "hs13-dc01"
  config.vm.communicator = "winrm"
  config.winrm.username   = "vagrant"
  config.winrm.password   = "vagrant"
  config.winrm.transport   = :negotiate
  # Retry budget covers the post-DCPROMO auth window: when wait-bootstrap
  # connects, OPS\vagrant may not yet have Domain Admin (Phase B hasn't run).
  # Vagrant retries on connect-side errors; with auth flapping briefly,
  # retry_limit=300 over a 60s effective wait means ~5 min of patience.
  config.winrm.retry_limit = 300
  config.winrm.timeout     = 300

  # 40 min: jborean93 box's first-boot sysprep is slow (~25 min) when other
  # VMs share the host's disk I/O. The bootstrap-chain reload after DCPROMO
  # also needs headroom because Phase A reboots the OS twice.
  config.vm.boot_timeout = 2400

  config.vm.provider "virtualbox" do |vb, override|
    vb.gui = false
    vb.memory = 4096
    vb.cpus   = 2
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    # No private_network: the Inspect bridge connects via NAT-forwarded
    # host.docker.internal:2223, and a second VM can't share another
    # scenario's host-only adapter while it's running on VBox 7.2
    # (VERR_INTNET_FLT_IF_NOT_FOUND).
    # Forward OpenSSH so the Inspect bridge can reach it via host.docker.internal:2223.
    # 2222 is reserved for scenario-14's FreeBSD VM. `id: "ssh"` overrides
    # the box's default 22→2222 forward instead of adding a duplicate.
    override.vm.network "forwarded_port", guest: 22, host: 2223,
                                          id: "ssh", auto_correct: true
  end

  config.vm.provider "hyperv" do |hv, override|
    hv.memory = 4096
    hv.cpus   = 2
    hv.enable_virtualization_extensions = false
    hv.linked_clone = true
    # Hyper-V would otherwise SMB-share ./ into /vagrant and prompt for the
    # host user's password. Upload via `file` provisioners below instead.
    override.vm.synced_folder ".", "/vagrant", disabled: true
  end

  # Upload data files the provisioning scripts read (provider-agnostic).
  config.vm.provision "file",
    source: "build/roles.json",
    destination: "C:/Users/vagrant/provisioning/roles.json"
  config.vm.provision "file",
    source: "build/vagrant_key.pub",
    destination: "C:/Users/vagrant/provisioning/vagrant_key.pub"
  config.vm.provision "file",
    source: "seed.ps1",
    destination: "C:/Users/vagrant/provisioning/seed.ps1"
  config.vm.provision "file",
    source: "provision/dc-bootstrap.ps1",
    destination: "C:/Users/vagrant/provisioning/dc-bootstrap.ps1"
  # verify.ps1 is uploaded by the Inspect scorer over SSH at eval time
  # (see scorer.py _run_verify), so it is intentionally NOT shipped here.

  # Stage 1: install AD-DS role + register the self-driving bootstrap task.
  config.vm.provision "shell",
    name: "register-dc-bootstrap",
    path: "provision/01-register-dc-bootstrap.ps1",
    privileged: true

  # Stage 2: graceful reboot. Triggers the SYSTEM hs13-bootstrap task on
  # the next boot, which does DCPROMO + DA grant + seed + OpenSSH + marker
  # all inside one SYSTEM-context script (no WinRM session held).
  config.vm.provision :reload

  # Stage 3: WinRM reconnects as OPS\vagrant (which now has Domain Admin
  # because the bootstrap task granted it before writing the marker).
  # Poll for the marker; throw if the chain didn't finish.
  config.vm.provision "shell",
    name: "wait-bootstrap",
    path: "provision/02-wait-bootstrap.ps1",
    privileged: true
end
