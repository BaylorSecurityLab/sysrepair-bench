# Bridge container for scenario-13-ad-dc-win2019.
# The Windows AD DC runs in a Vagrant VM (WinRM-managed by Vagrant); this
# container holds the SSH key the pipeline generated and acts as the Inspect
# sandbox — the agent SSHes from here to the VM's OpenSSH Server.
# build/vagrant_key is generated by the pipeline in task.py before `docker build`.
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/*
COPY build/vagrant_key /root/.ssh/vagrant_key
RUN chmod 700 /root/.ssh && chmod 600 /root/.ssh/vagrant_key
RUN printf 'Host *\n    StrictHostKeyChecking no\n    UserKnownHostsFile /dev/null\n    LogLevel QUIET\n' \
    > /root/.ssh/config && chmod 600 /root/.ssh/config
