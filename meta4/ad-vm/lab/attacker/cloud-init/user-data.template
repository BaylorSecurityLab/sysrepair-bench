#cloud-config
# Template. New-CloudInitSeedIso substitutes the public-key placeholder below
# and packs the rendered result into the NoCloud seed ISO.
#
# THIS IS PLAIN CLOUD-CONFIG, FOR THE UBUNTU CLOUD IMAGE.
#
# It is deliberately NOT an `autoinstall:` document. Two different artifacts
# are involved and they take different input:
#
#   cloud image (.img -> VHDX)   already installed; boots straight into
#                                cloud-init, which consumes this file. No
#                                installer, no prompts. THIS IS WHAT WE USE.
#
#   live-server ISO              runs the subiquity installer, which only acts
#                                on an `autoinstall:` document AND requires
#                                `autoinstall` on the kernel command line.
#                                Canonical's own quickstart: "To skip the need
#                                for a confirmation, interrupt the booting
#                                process, and add the autoinstall parameter to
#                                the kernel command line." A NoCloud seed alone
#                                never suppresses that prompt, so the ISO route
#                                cannot be made unattended without remastering.
#
# The SSH key matters: every host-side probe (Test-AttackerReady,
# Sync-LabClocks, Test-LabEgress) shells out to ssh with -o BatchMode=yes.
# Password-only auth would make each of them hang at a prompt.

hostname: attacker01
fqdn: attacker01.corp.local
prefer_fqdn_over_hostname: false

users:
  - name: vagrant
    gecos: SysRepair-Bench attacker
    groups: [sudo, docker]
    shell: /bin/bash
    lock_passwd: false
    # sha512-crypt of "vagrant" -- the credential the 20 scenarios expect.
    passwd: "$6$cU3Wj3YsR.0N9IMA$lEhW7f5Fh8kWvRT4OIfF8wxAA08WuMdvwo6tVnRYIW4Z3/vKh0k4Vi2Q.vKKDKLOF6PldFuF/Z8UvyoU6eyle1"
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - __SSH_PUBKEY__

ssh_pwauth: true
disable_root: true

write_files:
  # Static address on the AD segment. dhcp4 stays on so the VM still works on
  # SRB-Build during the bake, where it needs internet for docker.io; the
  # explicit address is what it uses once moved to SRB-Lab.
  # NOTE: network addressing is NOT configured here. It lives in the seed's
  # `network-config` file, which is the supported NoCloud mechanism --
  # cloud-init consumes it during boot and renders netplan itself. Writing a
  # netplan file here and calling `netplan apply` in runcmd was tried and left
  # the guest unreachable: cloud-init ran (the hostname applied) but the
  # static address never came up.

  # NOTE: /etc/docker/daemon.json deliberately does NOT pin DNS.
  #
  # Pinning "dns": ["10.20.30.5"] there was tried and broke image builds. A
  # daemon-level DNS pin applies to BUILD containers too -- and even to
  # `docker build --network host`, because Docker still injects its own
  # resolv.conf. The DC cannot resolve http.kali.org, so every build failed
  # with "Temporary failure resolving 'http.kali.org'" and then a wall of
  # "Unable to locate package" for basics like nmap and git.
  #
  # DNS for the tooling container is supplied per-run instead:
  #   docker run --network host --dns 10.20.30.5 --dns-search corp.local ...
  # which is what LabReadiness.psm1's Test-AttackerReady and the scenario
  # runner both do. That gives the container the DC at runtime on the isolated
  # segment while leaving builds able to reach the internet.

  # defer: true is REQUIRED. write_files runs before the users module, so
  # without it cloud-init fails the whole write_files stage with:
  #   OSError('Unknown user or group: "getpwnam(): name not found: \'vagrant\'"')
  # which silently drops every other file in this block too.
  - path: /home/vagrant/creds.txt
    owner: vagrant:vagrant
    permissions: '0600'
    defer: true
    content: |
      # Seed credentials for meta4/ad-vm scenarios
      corp\alice:Password1!

packages:
  - docker.io
  - curl
  - chrony

package_update: true

runcmd:
  - systemctl enable --now docker
  - usermod -aG docker vagrant
  - install -d -m 755 /opt/meta4
  - netplan apply
  # Belt and braces: if netplan somehow did not bring up the lab address,
  # add it directly to whichever interface carries the default route. Without
  # this a naming or match failure leaves the guest silently unreachable, and
  # the only symptom from the host is a VM that pings nothing.
  - [ sh, -c, "ip -4 addr show | grep -q '10\\.20\\.30\\.10' || ip addr add 10.20.30.10/24 dev $(ip -o link show | awk -F': ' '/hv_netvsc|eth|enp/{print $2; exit}')" ]
  - [ sh, -c, "echo ready > /var/log/srb-ready" ]
